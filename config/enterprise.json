    "readonly": {
      "name": "Read Only",
      "tier": "standard",
      "api_keys": ["gr_viewer_key"],
      "roles": {
        "gr_viewer_key": "viewer"
      },
      "policy_pack": "default",
      "allowed_tools": [
        "export_sarif",
